{
  "name": "kaimahi-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "docs:build": "vitepress build docs",
    "docs:check": "vitepress build docs && node --test docs/.vitepress/site.test.mjs",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:preview": "vitepress preview docs --host 127.0.0.1"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "vitepress": "2.0.0-alpha.20"
  }
}
