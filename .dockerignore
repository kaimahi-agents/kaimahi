# Keep any root build context free of development and operator scratch.
# Everything below is either
# irrelevant to a `go build` or must never enter an image: git history,
# local credential scratch, run output, brand binaries, built binaries.
.git
.gitignore
.env
bin/
backups/
brand/
docs/
k8s/
.github/
.synthetic-model/
__pycache__/
*.out
*.md
