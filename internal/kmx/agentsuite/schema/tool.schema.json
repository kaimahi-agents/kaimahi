{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaimahi.dev/schemas/agentsuite/v1/tool.schema.json",
  "title": "AgentSuite tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mediaType", "id", "version", "provider"],
  "properties": {
    "schemaVersion": {"const": "1.0.0-draft"},
    "mediaType": {"const": "application/vnd.agentsuite.tool.v1+json"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/version"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "revision", "operations"],
      "properties": {
        "protocol": {"const": "mcp"},
        "revision": {"type": "string", "minLength": 1},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "inputSchema"],
            "properties": {
              "name": {"$ref": "#/$defs/id"},
              "description": {"type": "string"},
              "inputSchema": {"$ref": "#/$defs/fileRef"},
              "outputSchema": {"$ref": "#/$defs/fileRef"},
              "effects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/variant"}
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "urlRef"],
      "properties": {
        "transport": {"const": "streamable-http"},
        "urlRef": {"$ref": "#/$defs/env"},
        "headers": {"type": "array"},
        "secretRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "isolated": {
      "type": "object",
      "description": "Reserved in v1; validators reject this arm semantically.",
      "additionalProperties": false,
      "required": ["platformImages", "protocol", "revision"],
      "properties": {
        "platformImages": {"type": "array", "minItems": 1},
        "protocol": {"type": "string"},
        "revision": {"type": "string"}
      }
    },
    "extensions": {"type": "array"}
  },
  "oneOf": [
    {"required": ["variants"], "not": {"anyOf": [{"required": ["remote"]}, {"required": ["isolated"]}]}},
    {"required": ["remote"], "not": {"anyOf": [{"required": ["variants"]}, {"required": ["isolated"]}]}},
    {"required": ["isolated"], "not": {"anyOf": [{"required": ["variants"]}, {"required": ["remote"]}]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "env": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^/\\\\][^\\\\]*$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"const": "linux"},
        "architecture": {"enum": ["amd64", "arm64"]}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "variantDigest", "installRoot", "payloadRoot", "entrypoint", "runtime", "files"],
      "properties": {
        "platform": {"$ref": "#/$defs/platform"},
        "variantDigest": {"$ref": "#/$defs/digest"},
        "installRoot": {"type": "string", "pattern": "^/"},
        "relocatable": {"type": "boolean"},
        "payloadRoot": {"type": "string"},
        "entrypoint": {"type": "string", "pattern": "^/"},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "searchPath": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
        "environment": {"type": "array"},
        "writablePaths": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
        "network": {"type": "array"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["abi", "cpuBaseline"],
          "properties": {
            "abi": {"enum": ["static", "gnu", "musl"]},
            "abiVersion": {"type": "string"},
            "cpuBaseline": {"type": "string", "minLength": 1},
            "requiredBasePaths": {"type": "array", "items": {"type": "string", "pattern": "^/"}}
          }
        },
        "files": {"type": "array", "minItems": 1},
        "dependencies": {"type": "array"},
        "sbom": {"type": "object"},
        "provenance": {"type": "object"}
      }
    }
  }
}
