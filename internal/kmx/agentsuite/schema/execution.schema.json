{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaimahi.dev/schemas/agentsuite/v1/execution.schema.json",
  "title": "Agent image execution contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "protocol", "port", "healthPath", "inputs"],
  "properties": {
    "configuration": {"const": "agentkit-v0-mounted-v1"},
    "kind": {"const": "kubernetes-http-v1"},
    "protocol": {"const": "openai-chat-v1"},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "healthPath": {"type": "string", "pattern": "^/[^?#\\\\\\r\\n]*$"},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "environment", "secret"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "environment": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"},
          "secret": {"type": "boolean"}
        }
      }
    }
  }
}
