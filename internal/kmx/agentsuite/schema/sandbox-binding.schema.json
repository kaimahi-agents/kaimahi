{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaimahi.dev/schemas/agentsuite/v1/sandbox-binding.schema.json",
  "title": "Agent Sandbox Image binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mediaType", "suiteDigest", "agent", "platform", "buildProfile", "composition", "inventory"],
  "properties": {
    "schemaVersion": {"const": "1.0.0-draft"},
    "mediaType": {"const": "application/vnd.agentsuite.sandbox.binding.v1+json"},
    "suiteDigest": {"$ref": "#/$defs/digest"},
    "agent": {"$ref": "#/$defs/id"},
    "platform": {"$ref": "#/$defs/platform"},
    "buildProfile": {"type": "string", "minLength": 1},
    "composition": {"$ref": "#/$defs/compositionDescriptor"},
    "inventory": {"$ref": "#/$defs/descriptor"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"const": "linux"},
        "architecture": {"enum": ["amd64", "arm64"]}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "digest", "size"],
      "properties": {
        "mediaType": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "compositionDescriptor": {
      "allOf": [
        {"$ref": "#/$defs/descriptor"},
        {
          "properties": {
            "mediaType": {"const": "application/vnd.agentsuite.composition.v1+json"}
          }
        }
      ]
    }
  }
}
