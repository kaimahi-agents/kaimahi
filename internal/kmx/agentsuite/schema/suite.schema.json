{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaimahi.dev/schemas/agentsuite/v1/suite.schema.json",
  "title": "AgentSuite manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mediaType", "name", "agents", "toolCatalog", "compositions", "buildProfiles"],
  "properties": {
    "schemaVersion": {"const": "1.0.0-draft"},
    "mediaType": {"const": "application/vnd.agentsuite.manifest.v1+json"},
    "name": {"$ref": "#/$defs/id"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "toolCatalog": {"$ref": "#/$defs/ref"},
    "toolCompositions": {
      "description": "Digest-bound references to standalone Tool Sandbox Image build inputs.",
      "type": "array",
      "items": {
        "description": "One exact Tool composition for a Tool version and platform.",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "platform", "path", "digest"],
        "properties": {
          "id": {
            "description": "Tool identifier selected by the referenced composition.",
            "$ref": "#/$defs/id"
          },
          "version": {
            "description": "Exact Tool version selected by the referenced composition.",
            "$ref": "#/$defs/version"
          },
          "platform": {
            "description": "Exact platform selected by the referenced composition.",
            "$ref": "#/$defs/platform"
          },
          "path": {
            "description": "Relative content path of the Tool composition manifest.",
            "$ref": "#/$defs/path"
          },
          "digest": {
            "description": "JCS SHA-256 digest of the Tool composition manifest.",
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "compositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent", "platform", "path", "digest"],
        "properties": {
          "agent": {"$ref": "#/$defs/id"},
          "platform": {"$ref": "#/$defs/platform"},
          "path": {"$ref": "#/$defs/path"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "buildProfiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ref"}
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"}
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^/\\\\][^\\\\]*$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"const": "linux"},
        "architecture": {"enum": ["amd64", "arm64"]},
        "variant": false
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string"},
        "path": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "critical"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"},
          "critical": {"type": "boolean"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    }
  }
}
