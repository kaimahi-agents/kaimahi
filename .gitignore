.env
bin/
.worktrees/
# Local-only credential scratch (Slack bot token, channel id). Never committed.
.env

# Verification artifacts written into the working tree by the runbooks and
# by CI (`make chat | tee chat.out`, ledger/audit dumps). They are run
# output, not source — and a captured A2A task or an AKS transcript is
# exactly the kind of thing that must not land in a public repo.
*.out

# Python bytecode caches: two .pyc files once landed on main because this
# rule was missing.
__pycache__/
*.pyc

# `make backup` output: a pg_dump of the plane's database (credential
# hashes, the ledger, audit trails). Operator data, never source.
backups/

# CI's synthetic hosted upstream (scripts/ci/synthetic-upstream.sh): a
# throwaway CA, its key and certificate, and the patched table. Job-local.
.synthetic-upstream/

# Scratch space: meeting transcripts, brand working files, anything not for the repo.
# This is a PUBLIC repository — an untracked tmp/ is one `git add -A` from being one.
tmp/

# `kmx tools add` output: the reviewable manifest for an upstream an
# operator onboarded (docs/govern-your-agent.md). It is theirs, and on a
# CI runner it is job-local — not this repo's source.
upstreams/

# `kmx migrate` output: the identity and seam allowance kmx applies, and
# the patch it leaves for the adopter to apply to their own Deployment
# (docs/migrate.md). Same reasoning as above — it describes somebody
# else's workload, not this repository's source.
migrations/
