---
config:
  theme: base
  themeCSS: |
    .edgeLabels .edgeLabel span,
    .edgeLabels .edgeLabel p {
      color: #F7F4E8 !important;
      fill: #F7F4E8 !important;
    }
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: SIMPLE
    nodePlacementAlignment: BALANCED
    forceNodeModelOrder: true
    considerModelOrder: NODES_AND_EDGES
  flowchart:
    htmlLabels: true
    nodeSpacing: 24
    rankSpacing: 36
    curve: linear
  themeVariables:
    background: "#071827"
    fontFamily: "Arial, Helvetica, sans-serif"
    fontSize: 20px
    textColor: "#F7F4E8"
    titleColor: "#F7F4E8"
    nodeTextColor: "#F7F4E8"
    primaryColor: "#F7F4E8"
    primaryTextColor: "#071827"
    primaryBorderColor: "#24D6D9"
    lineColor: "#24D6D9"
    edgeLabelBackground: "#071827"
    clusterBkg: "#0D2947"
    clusterBorder: "#24D6D9"
---
flowchart TB
    accTitle: Kaimahi governance architecture
    accDescr: The kmx developer entry point provisions the cluster, scaffolds agents and deploys the model-traffic bridge, sitting outside every request path. A Kubernetes-hosted agent then reaches models and tools through Kaimahi's governed paths, and external events reach the agent through Kaimahi's governed inbound bridge, while dashed direct paths are explicitly ungoverned.

    D["kmx · developer entry point<br/>provision · scaffold · govern · read<br/>not in any request path"]
    W["External event<br/>webhook"]
    A["Kubernetes-hosted<br/>agent"]

    subgraph K[" "]
      direction TB
      H["Kaimahi<br/>model-traffic bridge"]
      P["Bounded approvals<br/>expiry and/or use count"]
      L["LLM proxy<br/>auth · budgets<br/>credential custody<br/>spend ledger"]
      T["MCP gateway<br/>request auth · allowlists<br/>upstream bounds · audit<br/>proxy-side credential custody<br/>credential injection<br/>(keyed upstreams only)"]
      N["Inbound bridge<br/>auth before any work<br/>rate and size bounds<br/>replay protection<br/>budget preview · audit"]
      H ~~~ P
      P -. "temporary grant" .-> L
      P -. "temporary grant" .-> T
      P -. "temporary grant" .-> N
    end

    subgraph E[" "]
      direction LR
      M["Model provider"]
      X["MCP tool server"]
    end

    D -. "creates the cluster,<br/>applies the agent" .-> A
    D -. "deploys the plane,<br/>issues credentials" .-> H
    W -->|"governed<br/>trigger"| N
    N -->|"invoke"| A
    A -->|"governed<br/>model call"| L
    A -->|"governed<br/>tool call"| T
    L --> M
    T --> X
    A -. "plain preset<br/>ungoverned" .-> M
    A -. "direct MCP<br/>ungoverned" .-> X

    classDef agent fill:#F7F4E8,color:#071827,stroke:#24D6D9,stroke-width:3px,font-size:22px,font-weight:bold;
    classDef control fill:#F7F4E8,color:#071827,stroke:#60A5FA,stroke-width:3px,font-size:20px;
    classDef approval fill:#FFF1B3,color:#071827,stroke:#FFB547,stroke-width:3px,font-size:20px;
    classDef target fill:#F7F4E8,color:#071827,stroke:#60A5FA,stroke-width:3px,font-size:20px,font-weight:bold;
    classDef tooling fill:#0D2947,color:#F7F4E8,stroke:#F7F4E8,stroke-width:2px,stroke-dasharray:6 4,font-size:19px;
    classDef heading fill:transparent,color:#F7F4E8,stroke:transparent,font-size:20px,font-weight:bold;
    class A agent;
    class L,T,N control;
    class P approval;
    class H heading;
    class M,X target;
    class W target;
    class D tooling;
    style K fill:#0D2947,stroke:#24D6D9,stroke-width:3px,color:#F7F4E8
    style E fill:transparent,stroke:transparent
    linkStyle 0 stroke:transparent,fill:none;
    linkStyle 1,2,3 stroke:#FFB547,color:#FFF1B3,stroke-width:3px,stroke-dasharray:7 5;
    linkStyle 4,5 stroke:#F7F4E8,color:#F7F4E8,stroke-width:3px,stroke-dasharray:6 4;
    linkStyle 6,7,8,9 stroke:#24D6D9,color:#F7F4E8,stroke-width:4px;
    linkStyle 10,11 stroke:#60A5FA,color:#F7F4E8,stroke-width:4px;
    linkStyle 12,13 stroke:#FFB547,color:#FFF1B3,stroke-width:3px,stroke-dasharray:9 6;
